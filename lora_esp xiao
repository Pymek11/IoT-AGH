// Nadajnik LoRa P2P – XIAO ESP32S3 & Wio-SX1262 Kit
// Biblioteka: RadioLib (Arduino Library Manager)
// Płytka: "XIAO_ESP32S3" (rdzeń esp32 od Espressif)

#include <RadioLib.h>

// Piny kitu XIAO ESP32S3 + Wio-SX1262: NSS, DIO1, RST, BUSY
SX1262 radio = new Module(41, 39, 42, 40);

// Parametry radia – MUSZĄ być identyczne w nadajniku i odbiorniku
const float FREQ_MHZ  = 868.1;   // kanał EU868
const float BW_KHZ    = 125.0;
const uint8_t SF      = 7;       // 7 = szybko/krótko, 12 = max zasięg
const uint8_t CR      = 5;       // 4/5
const int8_t  POWER   = 14;      // dBm – limit EU868
const float TCXO_V    = 1.8;     // Wio-SX1262: TCXO zasilane z DIO3 (1.7–3.3 V)

const uint8_t SENSOR_ID = 4;
uint8_t counter = 0;

void setup() {
  Serial.begin(115200);
  delay(2000);

  int st = radio.begin(FREQ_MHZ, BW_KHZ, SF, CR,
                       RADIOLIB_SX126X_SYNC_WORD_PRIVATE, POWER, 8, TCXO_V);
  if (st != RADIOLIB_ERR_NONE) {
    Serial.printf("radio.begin() blad: %d\n", st);
    while (true) delay(1000);
  }
  radio.setDio2AsRfSwitch(true);   // DIO2 steruje przełącznikiem antenowym
  Serial.println("Nadajnik gotowy");
}

void loop() {
  // 3 bajty, jak w docelowym systemie: [id czujnika, typ zdarzenia, licznik]
  uint8_t payload[3] = { SENSOR_ID, 1 /* 1 = test */, counter++ };

  int st = radio.transmit(payload, sizeof(payload));
  if (st == RADIOLIB_ERR_NONE) {
    Serial.printf("Wyslano #%u\n", payload[2]);
  } else {
    Serial.printf("transmit() blad: %d\n", st);
  }

  delay(10000);  // co 10 s – mieści się w duty cycle 1% przy SF7
}